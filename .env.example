# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS + Origin checks)
ORIGINS=http://localhost:5173

# PostgreSQL (Drizzle ORM over node-postgres)
DATABASE_URL=postgres://user:password@localhost:5432/nexus
# "true" to require TLS with certificate verification (managed Postgres); "false" for local
DATABASE_SSL=false

# JWT (use long random strings, different for each)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
